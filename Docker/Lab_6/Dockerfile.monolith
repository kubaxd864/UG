FROM node:20-bookworm-slim AS frontend-build

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:20-bookworm-slim AS backend-deps

WORKDIR /backend
COPY backend/package*.json ./
RUN npm ci --omit=dev

FROM node:20-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx postgresql gosu ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=backend-deps /backend/node_modules /app/backend/node_modules
COPY backend/package.json /app/backend/package.json
COPY backend/index.js /app/backend/index.js
COPY backend/db.js /app/backend/db.js

COPY --from=frontend-build /frontend/out /usr/share/nginx/html
COPY frontend/nginx.monolith.conf /etc/nginx/conf.d/default.conf
COPY docker/initdb/ /app/docker/initdb/

COPY docker/start-monolith.sh /usr/local/bin/start-monolith.sh
RUN chmod +x /usr/local/bin/start-monolith.sh \
    && mkdir -p /var/lib/postgresql/data /run/postgresql \
    && chown -R postgres:postgres /var/lib/postgresql /run/postgresql

ENV POSTGRES_USER=postgres \
    POSTGRES_PASSWORD=secret \
    POSTGRES_DB=items \
    POSTGRES_HOST=127.0.0.1 \
    POSTGRES_PORT=5432 \
    NODE_ENV=production \
    PORT=5000

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ > /dev/null || exit 1

CMD ["/usr/local/bin/start-monolith.sh"]
