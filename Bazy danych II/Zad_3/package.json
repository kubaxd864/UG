{
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "sequelize-cli db:migrate --config sequelize.config.cjs --migrations-path db/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config sequelize.config.cjs --migrations-path db/migrations",
    "db:migrate:test": "sequelize-cli db:migrate --env test --config sequelize.config.cjs --migrations-path db/migrations",
    "db:seed:dev": "sequelize-cli db:seed:all --config sequelize.config.cjs --seeders-path db/seeds/development",
    "db:seed:dev:undo": "sequelize-cli db:seed:undo:all --config sequelize.config.cjs --seeders-path db/seeds/development",
    "db:seed:test": "sequelize-cli db:seed:all --env test --config sequelize.config.cjs --seeders-path db/seeds/test",
    "db:seed:test:undo": "sequelize-cli db:seed:undo:all --env test --config sequelize.config.cjs --seeders-path db/seeds/test"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "faker": "^6.6.6",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  }
}
